<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>gr.pnet.camara</groupId>
		<artifactId>camara-parent</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>qualityondemand</artifactId>
	<name>qualityondemand</name>
	<description>CAMARA Quality-On-Demand API (v1.1.0) backed by the TEP 5G core exposure API</description>
	<properties>
		<jib.skip>false</jib.skip>
	</properties>
	<dependencies>
		<dependency>
			<groupId>gr.pnet.camara</groupId>
			<artifactId>camara-common</artifactId>
		</dependency>
		<dependency>
			<groupId>gr.pnet.camara</groupId>
			<artifactId>tep-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Sessions, their expiry and the per-device create lock live in Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- RedisSessionStoreIT runs against a real Redis when Docker is available, and is skipped otherwise -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>qualityondemand-server</id>
                        <goals>
                        <goal>generate</goal>
                        </goals>
                        <configuration>
                        <!-- In static/ so Swagger UI serves the very file the server is generated from -->
                        <inputSpec>${project.basedir}/src/main/resources/static/quality-on-demand.yaml</inputSpec>
                        <output>${project.build.directory}/generated-sources/qualityondemand-server</output>
                        <generatorName>spring</generatorName>
                        <apiPackage>gr.pnet.camara.qualityondemand.generated.status</apiPackage>
                        <modelPackage>gr.pnet.camara.qualityondemand.generated.status.model</modelPackage>
                        <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                        <!-- sink is format: uri with a pattern: as java.net.URI, its @Pattern has no validator and
                             every createSession fails with 500. As a String, the https:// rule gives a 400 -->
                        <typeMappings>
                            <typeMapping>URI=String</typeMapping>
                        </typeMappings>
                        <configOptions>
                            <useSpringBoot4>true</useSpringBoot4>
                            <delegatePattern>true</delegatePattern>
                            <useTags>true</useTags>
                            <useJakartaEe>true</useJakartaEe>
                            <openApiNullable>false</openApiNullable>
                            <unhandledException>true</unhandledException>
                            <!-- PortsSpec's lists are each optional but minItems 1: defaulted to [], an omitted
                                 one fails @Size, so ports without ranges (or the reverse) would get a 400 -->
                            <containerDefaultToNull>true</containerDefaultToNull>
                        </configOptions>
                        <generateApiTests>false</generateApiTests>
                        <generateModelTests>false</generateModelTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
