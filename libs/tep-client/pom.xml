<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>gr.pnet.camara</groupId>
		<artifactId>camara-parent</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>tep-client</artifactId>
	<name>tep-client</name>
	<description>TEP API client generated from the hand-written TEP spec, with the shared RestClient wiring</description>

	<dependencies>
		<dependency>
			<groupId>gr.pnet.camara</groupId>
			<artifactId>camara-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>tepclient</id>
                        <goals>
                        <goal>generate</goal>
                        </goals>
                        <configuration>
                        <inputSpec>${project.basedir}/src/main/openapi/tep-api.openapi.yaml</inputSpec>
                        <output>${project.build.directory}/generated-sources/tep-client</output>
                        <generatorName>java</generatorName>
                        <library>restclient</library>
                        <apiPackage>gr.pnet.tepclient</apiPackage>
                        <invokerPackage>gr.pnet.tepclient.invoker</invokerPackage>
                        <modelPackage>gr.pnet.tepclient.model</modelPackage>
                        <!-- 3GPP extensible enums (anyOf an enum and a plain string, e.g. UserPlaneEvent)
                             otherwise generate as an empty class; read them as plain strings -->
                        <openapiNormalizer>SIMPLIFY_ANYOF_STRING_AND_ENUM_STRING=true</openapiNormalizer>
                        <configOptions>
                            <additionalModelTypeAnnotations>
                            @com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)
                            </additionalModelTypeAnnotations>
                            <useSpringBoot4>true</useSpringBoot4>
                            <useJackson3>true</useJackson3>
                            <useJakartaEe>true</useJakartaEe>
                            <openApiNullable>false</openApiNullable>
                        </configOptions>
                        <generateApiTests>false</generateApiTests>
                        <generateModelTests>false</generateModelTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
