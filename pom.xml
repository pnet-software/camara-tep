<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>gr.pnet.camara</groupId>
	<artifactId>camara-parent</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>
	<name>camara-parent</name>
	<description>CAMARA APIs backed by the TEP 5G core exposure API: shared build, libraries and services</description>
	<url>https://github.com/pnet-software/camara-tep</url>

	<scm>
		<url>https://github.com/pnet-software/camara-tep</url>
		<connection>scm:git:https://github.com/pnet-software/camara-tep.git</connection>
		<developerConnection>scm:git:https://github.com/pnet-software/camara-tep.git</developerConnection>
	</scm>

	<modules>
		<module>libs/camara-common</module>
		<module>libs/tep-client</module>
		<module>services/reachability</module>
		<module>services/roaming</module>
		<module>services/locationverification</module>
        <module>services/deviceswap</module>
        <module>services/simswap</module>
        <module>services/qosprofiles</module>
        <module>services/qualityondemand</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<!-- One version for the whole reactor. CI sets it from the service tag (<service>-vX.Y.Z → -Drevision=X.Y.Z);
		     libraries are built in the same reactor and never published, so only the service's version is visible -->
		<revision>1.0.0-SNAPSHOT</revision>
		<openapi-generator.version>7.22.0</openapi-generator.version>
		<springdoc.version>3.1.0</springdoc.version>
		<jacoco.version>0.8.13</jacoco.version>
		<flatten.version>1.7.0</flatten.version>
		<jib.version>3.4.5</jib.version>
		<!-- CI passes -Dimage=docker.io/<namespace>/<service>:<tag> -->
		<image>${project.artifactId}:local</image>
		<jib.from.image>eclipse-temurin:17-jre</jib.from.image>
		<!-- CI passes -Dimage.revision=$GITHUB_SHA -->
		<image.revision>unknown</image.revision>
		<!-- Only services build images; they set this to false -->
		<jib.skip>true</jib.skip>
		<coverage.minimum>0.80</coverage.minimum>
		<coverage.enforce>true</coverage.enforce>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>gr.pnet.camara</groupId>
				<artifactId>camara-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>gr.pnet.camara</groupId>
				<artifactId>tep-client</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <configuration>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib.version}</version>
                    <configuration>
                        <skip>${jib.skip}</skip>
                        <from>
                            <image>${jib.from.image}</image>
                        </from>
                        <to>
                            <image>${image}</image>
                        </to>
                        <container>
                            <user>10001:10001</user>
                            <ports>
                                <port>8080</port>
                                <port>8081</port>
                            </ports>
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                            <labels>
                                <org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
                                <org.opencontainers.image.description>${project.description}</org.opencontainers.image.description>
                                <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
                                <org.opencontainers.image.revision>${image.revision}</org.opencontainers.image.revision>
                            </labels>
                        </container>
                        <!-- Drops spring-boot-devtools: Jib starts with java -cp, which would otherwise activate it -->
                        <pluginExtensions>
                            <pluginExtension>
                                <implementation>com.google.cloud.tools.jib.maven.extension.springboot.JibSpringBootExtension</implementation>
                            </pluginExtension>
                        </pluginExtensions>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.google.cloud.tools</groupId>
                            <artifactId>jib-spring-boot-extension-maven</artifactId>
                            <version>0.1.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Inherited by every module -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>gr/pnet/camara/*/generated/**</exclude>
                        <exclude>gr/pnet/tepclient/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-it</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <!-- Unit and integration test coverage count together (tep-client is mostly covered by its IT) -->
                    <execution>
                        <id>merge</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <haltOnFailure>${coverage.enforce}</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
